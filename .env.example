# Copie este ficheiro para .env.local e preencha os valores.
# Nunca coloque aqui chaves secretas (service_role / sb_secret_...).

# Supabase > Project Settings > API (ou o resultado de `npx supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Endereço público da aplicação (usado nos links de email e de convite)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nome do produto (opcional)
NEXT_PUBLIC_APP_NAME=StayFlow

# Pagamentos online (Stripe Connect), só no servidor. Opcional: sem isto os
# pagamentos online ficam desligados. Nunca usar o prefixo NEXT_PUBLIC_.
# Stripe > Developers > API keys (comece com sk_test_)
STRIPE_SECRET_KEY=
# Stripe > Developers > Webhooks > endpoint de "Connected accounts" (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Valor aleatório com 32+ caracteres; o mesmo valor é registado na base de
# dados com: select private.set_integration_secret('stripe', '<valor>');
STRIPE_DB_SECRET=
